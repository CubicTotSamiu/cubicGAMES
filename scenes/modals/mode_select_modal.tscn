[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.9, 1, 1)
theme_override_font_sizes/font_size = 20
text = "ВЫБЕРИТЕ РЕЖИМ ИГРЫ: TRUE TRADER"
horizontal_alignment = 1

[node name="ModesContainer" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="CasualBox" type="VBoxContainer" parent="VBox/ModesContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="VBox/ModesContainer/CasualBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.9, 0.5, 1)
theme_override_font_sizes/font_size = 16
text = "🟢 КАЗУАЛ"
horizontal_alignment = 1

[node name="Desc" type="Label" parent="VBox/ModesContainer/CasualBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 11
text = "• Старт: $100
• Цель: $1,000
• Отключены голод, сон, аренда, счета и баны бирж.
• Чистая торговля по графику и новостям."
autowrap_mode = 2

[node name="Btn" type="Button" parent="VBox/ModesContainer/CasualBox"]
layout_mode = 2
text = "Играть (Казуал)"

[node name="RealismBox" type="VBoxContainer" parent="VBox/ModesContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="VBox/ModesContainer/RealismBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0, 1)
theme_override_font_sizes/font_size = 16
text = "🟡 РЕАЛИЗМ"
horizontal_alignment = 1

[node name="Desc" type="Label" parent="VBox/ModesContainer/RealismBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 11
text = "• Старт: $1,000, табуретка, CRT монитор
• Цель: $10,000 или выжить 30 дней
• Включены: сон, еда, тильт, аренда, кредиты, взломы и KYC бирж, апгрейды."
autowrap_mode = 2

[node name="Btn" type="Button" parent="VBox/ModesContainer/RealismBox"]
layout_mode = 2
text = "Играть (Реализм)"

[node name="CustomBox" type="VBoxContainer" parent="VBox/ModesContainer"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Title" type="Label" parent="VBox/ModesContainer/CustomBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.5, 1, 1)
theme_override_font_sizes/font_size = 16
text = "🟣 ПЕСОЧНИЦА"
horizontal_alignment = 1

[node name="Desc" type="Label" parent="VBox/ModesContainer/CustomBox"]
