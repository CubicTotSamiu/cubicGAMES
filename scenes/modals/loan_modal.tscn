corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="LoanModal" type="PanelContainer"]
custom_minimum_size = Vector2(600, 440)
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -220.0
offset_right = 300.0
offset_bottom = 220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")
script = ExtResource("1_loan")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.3, 0.2, 1)
theme_override_font_sizes/font_size = 18
text = "💸 КРЕДИТЫ И МИКРОЗАЙМЫ"

[node name="CloseBtn" type="Button" parent="VBox/Header"]
custom_minimum_size = Vector2(30, 30)
layout_mode = 2
text = "✕"

[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="DebtLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)
theme_override_font_sizes/font_size = 15
text = "Текущий суммарный долг: $0.00"

[node name="Actions" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BankBtn" type="Button" parent="VBox/Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "🏦 Взять кредит в банке ($500, 3%/день)"

[node name="MicroBtn" type="Button" parent="VBox/Actions"]
layout_mode = 2
size_flags_horizontal = 3
text = "⚡ Быстрый микрозайм ($100, 8%/день)"

[node name="HSeparator2" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="LoanListTitle" type="Label" parent="VBox"]
layout_mode = 2
text = "Список активных займов:"

[node name="LoanList" type="VBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="InfoLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.4, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "Внимание: Просрочка долга более 7 дней привлекает коллекторов и ведет к проигрышу!"

[connection signal="pressed" from="VBox/Header/CloseBtn" to="." method="_on_close_btn_pressed"]
[connection signal="pressed" from="VBox/Actions/BankBtn" to="." method="_on_take_bank_loan_pressed"]
[connection signal="pressed" from="VBox/Actions/MicroBtn" to="." method="_on_take_micro_loan_pressed"]
