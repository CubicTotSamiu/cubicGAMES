[gd_scene format=3 uid="uid://dm0loanmodal01"]

[ext_resource type="Script" path="res://scenes/modals/loan_modal.gd" id="1_loan"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.12, 0.1, 0.1, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
